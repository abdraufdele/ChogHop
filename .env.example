# Server only. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# development | production; browser fixtures explicitly use test.
CHOGHOP_ENVIRONMENT=development
# Optional, used only by a trusted migration tool; never by the browser.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical browser origin, no trailing slash. Required in production.
CHOGHOP_APP_ORIGIN=http://127.0.0.1:3000
# 143 (Monad) or 10143 (Monad Testnet); never inferred from an NFT address.
MONAD_CHAIN_ID=
MONAD_RPC_URL=
CHOG_COLLECTION_ADDRESS=
# This adapter supports ERC721 only. Other standards fail closed.
CHOG_COLLECTION_STANDARD=
CHOG_DEPLOYMENT_BLOCK=
# Match the configured provider's documented eth_getLogs limit.
CHOG_LOG_BLOCK_SPAN=10
# Exact trusted HTTPS hostnames for tokenURI JSON and raster portraits, comma-separated.
# Empty disables remote portraits. IPFS/data URIs and redirects are not supported.
CHOG_MEDIA_HOSTS=
