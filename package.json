{
  "name": "choghop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.19.0", "npm": "10.9.3" },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "tailwindcss": "4.3.3"
  }
}
